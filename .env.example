# RaghuMayaShop — environment template.
#   cp .env.example .env   then fill in the two REQUIRED secrets below.
# Never commit a real .env. (.env is gitignored and dockerignored.)
#
# How URLs work:
# - Values in THIS file with `localhost` are for commands run on the HOST
#   (e.g. `npm run db:migrate` outside Docker).
# - Inside containers, docker-compose.yml overrides DATABASE_URL/REDIS_URL
#   to use the Docker service names (postgres / redis), so containers
#   never talk to localhost for the database. You do not need a second file.
# - NEXT_PUBLIC_API_URL is what the BROWSER calls, so it stays localhost.

# ---------- REQUIRED — you must provide these (no usable defaults) ----------
# JWT_SECRET: at least 32 characters. Generate one:
#   Git Bash:  openssl rand -base64 48
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET="REPLACE-ME-with-a-long-random-secret-at-least-32-chars"
# ENCRYPTION_KEY: exactly 64 hex chars (32 bytes), AES-256-GCM for TOTP secrets.
#   Git Bash:  openssl rand -hex 32
#   PowerShell: ([BitConverter]::ToString((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]]) -replace '-','').ToLower()
ENCRYPTION_KEY="REPLACE-ME-with-64-hex-chars-from-openssl-rand-hex-32-0123456789abcdef"

# ---------- Database / Redis (Docker defaults are fine locally) ----------
POSTGRES_USER=raghumaya
POSTGRES_PASSWORD=raghumaya_dev_password
POSTGRES_DB=raghumaya
# Host-side URL (localhost). Containers override this with postgres:5432.
DATABASE_URL="postgresql://raghumaya:raghumaya_dev_password@localhost:5433/raghumaya"
# Host-side URL (localhost). Containers override this with redis:6379.
REDIS_URL="redis://localhost:6379"

# ---------- API ----------
PORT=4000
NODE_ENV=development
API_BASE_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:3000"
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
STORAGE_DIR="./storage"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30

# ---------- Outgoing email — ALL OPTIONAL ----------
# When unset, shop creation still works; the welcome-credentials email is
# simply skipped. Configure at most one option (see apps/api/.env.example
# for the full setup notes).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
RESEND_API_KEY=""
RESEND_FROM=""
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""

# ---------- Web (browser calls the API on localhost) ----------
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
# ---------- Mobile (Expo, run on the host — not in Docker) ----------
EXPO_PUBLIC_API_URL="http://localhost:4000/api/v1"
