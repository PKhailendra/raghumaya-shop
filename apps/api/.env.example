# --- Database / Redis ---
DATABASE_URL="postgresql://raghumaya:raghumaya@localhost:5432/raghumaya?schema=public"
REDIS_URL="redis://localhost:6379"

# --- Server ---
PORT=4000
NODE_ENV=development
API_BASE_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:3000"

# --- Auth ---
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
# 32-byte key (hex) used to AES-256-GCM encrypt TOTP secrets at rest.
ENCRYPTION_KEY="00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff"

# --- Storage ---
STORAGE_DIR="./storage"

# --- Rate limits (requests per window) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30

# --- Outgoing email — optional ---
# When set, the API emails login credentials to a new shop owner after
# super-admin shop creation. When unset, shop creation still works;
# the credentials email is simply skipped. All three options use
# nodemailer; pick the first one you configure.
#
# Option A (recommended): Gmail API over HTTPS — sends from your own Gmail
# address, works where outbound SMTP ports are blocked (e.g. Railway).
#   1. Create OAuth 2.0 credentials (Desktop app) at
#      https://console.cloud.google.com/apis/credentials
#   2. Get a refresh token at https://developers.google.com/oauthplayground
#      with scope https://www.googleapis.com/auth/gmail.send
# GMAIL_CLIENT_ID=""
# GMAIL_CLIENT_SECRET=""
# GMAIL_REFRESH_TOKEN=""
#
# Option B: Resend HTTP API — free tier 100 emails/day, no card.
# Sign up at https://resend.com, create an API key, and set:
# RESEND_API_KEY="re_..."
# RESEND_FROM="RaghuMayaShop <onboarding@resend.dev>"  (or your verified domain)
#
# Option C: SMTP — example for Gmail: host smtp.gmail.com, port 587,
# secure false, user = your Gmail address, pass = a Gmail App Password.
# NOTE: many cloud hosts (incl. Railway free tier) block outbound SMTP
# ports, in which case use Option A or B.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
RESEND_API_KEY=""
RESEND_FROM=""
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
